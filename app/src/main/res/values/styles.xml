<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Dialog theme overlay to ensure alert dialogs (including CountryCodePicker) use on-surface colors -->
    <style name="ThemeOverlay.Genzcrop.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Background and surface for dialog windows -->
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <!-- Dialog text colors -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <!-- Tint for search EditText and list items (if library honors these attrs) -->
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="colorControlActivated">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <!-- Icon shown in the center of the splash screen -->
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/playstore4</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <!-- Theme to switch to after splash is dismissed -->
        <item name="postSplashScreenTheme">@style/Theme.Genzcrop</item>
    </style>

    <!-- Removed custom MaterialDatePicker overlay: prefer using platform DatePickerDialog or
         the library-provided overlay at show-time to avoid attribute resolution/runtime crashes. -->

    <!-- Game mode: true immersive fullscreen — hides status + nav bars at theme level
         so there is no flash of system bars before the activity's hideSystemBars() runs. -->
    <style name="Theme.GameMode" parent="Theme.Genzcrop">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Extend into display cutout (notch) areas -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- Ensure no action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
