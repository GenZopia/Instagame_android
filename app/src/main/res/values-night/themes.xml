<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Genzcrop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/instagram_orange</item>
        <item name="colorPrimaryVariant">@color/instagram_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/instagram_orange_light</item>
        <item name="colorSecondaryVariant">@color/instagram_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_primary_dark</item>
        <item name="colorSurface">@color/background_secondary_dark</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <!-- Divider and border colors -->
        <item name="dividerColor">@color/divider_dark</item>
        <item name="colorOutline">@color/border_dark</item>

        <!-- Text Appearances -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Instagram.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Instagram.Headline2</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Instagram.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Instagram.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Instagram.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Instagram.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Instagram.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Instagram.Button</item>

        <!-- Button Styles -->
        <item name="materialButtonStyle">@style/Widget.Instagram.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Instagram.Button.Outlined</item>
        
    </style>
</resources>