<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state: thicker stroke using border_text_view_primary -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="@color/border_text_view_primary" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Selected state: same as focused (for programmatic toggling) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="@color/border_text_view_primary" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Pressed state: thicker stroke using border_text_view_primary -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="@color/border_text_view_primary" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Disabled state: use border_text_view_primary for consistent border color -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1dp" android:color="@color/border_text_view_primary" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Default state: use border_text_view_primary for the outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1dp" android:color="@color/border_text_view_primary" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>

</selector>
