<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".ui.profile.ProfileFragment">

    <!-- Top guideline: keeps profile area slightly below the absolute top -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.07" />

    <!-- top-right menu icon (stays at top) -->
    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_baseline_menu_24"
        android:contentDescription="Menu"
        app:tint="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:padding="6dp" />

    <!-- PROFILE AREA (flat, no card) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/topGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <!-- Profile image (slight elevation for depth only) -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profileImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/profile"
            app:civ_border_color="@color/instagram_orange"
            app:civ_border_width="2dp"
            android:scaleType="centerCrop"
            android:contentDescription="Profile image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="2dp" />

        <!-- Username to the right of avatar -->
        <TextView
            android:id="@+id/usernameTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="username"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintTop_toTopOf="@id/profileImage"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Stats row: equal columns with no heavy separators -->
        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintTop_toBottomOf="@id/usernameTop"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp">

            <!-- Post column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/postsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="0"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Posts"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- lightweight divider between stats (subtle) -->
<!--            <View-->
<!--                android:layout_width="1dp"-->
<!--                android:layout_height="50dp"-->

<!--                android:layout_marginEnd="6dp"-->
<!--                android:background="@color/border_light" />-->

            <!-- Followers column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
               >

                <TextView
                    android:id="@+id/followersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="0"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Followers"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

<!--            <View-->
<!--                android:layout_width="1dp"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_marginEnd="6dp"-->
<!--                android:background="@color/border_light" />-->

            <!-- Following column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/followingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="0"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Following"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons row below stats (flat, Instagram-like) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/editProfileBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="@android:color/transparent"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:hapticFeedbackEnabled="true"
            android:stateListAnimator="@null"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textColor="@color/instagram_orange"
            app:layout_constraintEnd_toStartOf="@+id/genzLabBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profileImage"
            app:rippleColor="@color/instagram_orange"
            app:strokeColor="@color/instagram_orange"
            android:foreground="?android:attr/selectableItemBackground"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/genzLabBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/editProfileBtn"
            app:layout_constraintBottom_toBottomOf="@id/editProfileBtn"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="6dp"
            android:text="GenZLab"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/instagram_orange"
            android:stateListAnimator="@null"
            android:clickable="true"
            android:focusable="true"
            android:hapticFeedbackEnabled="true"
            app:strokeWidth="1dp"
            app:strokeColor="@color/instagram_orange"
            android:backgroundTint="@android:color/transparent"
            android:elevation="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            app:rippleColor="@color/instagram_orange"
            android:foreground="?android:attr/selectableItemBackground" />

        <!-- Bio and website below buttons -->
        <TextView
            android:id="@+id/bio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/editProfileBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="This is your bio. Add something about yourself!"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@font/inter_medium"
            android:paddingLeft="2dp" />

        <TextView
            android:id="@+id/website"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/bio"
            app:layout_constraintStart_toStartOf="@id/bio"
            app:layout_constraintEnd_toEndOf="@id/bio"
            android:layout_marginTop="6dp"
            android:text="www.yourwebsite.com"
            android:textSize="14sp"
            android:textColor="@color/instagram_orange"
            android:fontFamily="@font/inter_bold"
            android:paddingLeft="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- lightweight divider under profile area (clean separation, non-boxy) -->
    <View
        android:id="@+id/profileDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintTop_toBottomOf="@id/profileArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- Tabs row (flat, professional) -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/profileDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/videos_ff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_grid"
            android:contentDescription="Posts"
            android:padding="6dp"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/games_ff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_reels"
            android:contentDescription="Reels"
            android:padding="6dp"
            app:tint="?android:attr/textColorSecondary"
            android:layout_marginStart="28dp" />

        <ImageView
            android:id="@+id/details_ff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_tagged"
            android:contentDescription="Tagged"
            android:padding="6dp"
            app:tint="?android:attr/textColorSecondary"
            android:layout_marginStart="28dp" />
    </LinearLayout>

    <!-- subtle separator under tabs -->
    <View
        android:id="@+id/tabsDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintTop_toBottomOf="@id/tabsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main content holder (the large area for grid/reels) -->
    <FrameLayout
        android:id="@+id/contentGridPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabsDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
