<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="80dp">

        <Button
            android:id="@+id/privacybtn"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="15dp"
            android:layout_height="90dp"
            android:backgroundTint="#FFFFFF"
            android:text="Privacy"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/privacy"
            app:iconPadding="40dp"
            app:iconSize="40dp"
            app:iconTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_feedback" />

        <Button
            android:id="@+id/logout_btn"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#FFFFFF"
            android:text="Log Out"
            android:textAlignment="textStart"
            android:layout_marginHorizontal="15dp"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/logout"
            app:iconPadding="40dp"
            app:iconSize="40dp"
            app:iconTint="#2196F3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.494"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/privacybtn"
            app:layout_constraintVertical_bias="0.0" />

        <Button
            android:layout_marginHorizontal="15dp"
            android:id="@+id/btn_feedback"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:backgroundTint="#FFFFFF"
            android:text="Feedback"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/feedback_icon"
            app:iconPadding="40dp"
            app:iconSize="40dp"
            app:iconTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/termsandcond_btn" />

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/textView4"
            android:layout_width="158dp"
            android:layout_height="59dp"
            android:fontFamily="@font/inter_medium"
            android:padding="10dp"
            android:shadowColor="#2196F3"
            android:shadowDx="3"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:text="Profile"
            android:textAlignment="center"
            android:textColor="#2196F3"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="56dp"
            android:background="@drawable/rectangularwithcurveedge"
            android:backgroundTint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <Button
            android:layout_marginHorizontal="15dp"
            android:id="@+id/accountbtn"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/inter_bold"
            android:text="Account"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/profile_icon"
            app:iconPadding="80dp"
            app:iconSize="40dp"
            app:iconTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView4" />

        <Button
            android:id="@+id/languagebtn"
            android:layout_marginHorizontal="15dp"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/inter_medium"
            android:text="Language"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"

            app:cornerRadius="20dp"
            app:icon="@drawable/language"
            app:iconPadding="70dp"
            app:iconSize="50dp"
            app:iconTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accountbtn"
            app:strokeColor="#FFFFFF" />

        <Button
            android:layout_marginHorizontal="15dp"
            android:id="@+id/termsandcond_btn"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:backgroundTint="#FFFFFF"
            android:text="Terms and Conditions"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/termsandconditions"
            app:iconPadding="40dp"
            app:iconSize="40dp"
            app:iconTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/languagebtn" />


        <TextView
            android:id="@+id/textView5"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/inter_bold"
            android:text="Version  1.0.0"
            android:textAlignment="center"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logout_btn"
            app:layout_constraintVertical_bias="1.0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="15dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@+id/imageView4"
            app:layout_constraintEnd_toEndOf="@+id/imageView4"
            app:layout_constraintStart_toStartOf="@+id/imageView4"
            app:layout_constraintTop_toTopOf="@+id/imageView4">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/circularButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="10dp"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:fontFamily="@font/inter_bold"
                android:text="User Name"
                android:textColor="#000000"
                android:textSize="20sp"
                tools:ignore="MissingConstraints" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>