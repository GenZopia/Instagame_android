<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Banner -->
                <ImageView
                    android:id="@+id/bannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:scaleType="centerCrop"
                    android:background="#1A1A1A"/>

                <!-- Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImage"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/demo_user"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/channelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Channel Name"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/subscriberCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 followers"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:id="@+id/channelWebsite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/instagram_orange"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/channelStory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:visibility="gone"/>

                        <!-- Follow Button -->
                        <Button
                            android:id="@+id/followButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:text="Follow"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/instagram_orange"
                            android:paddingHorizontal="20dp"
                            style="@style/Widget.MaterialComponents.Button"/>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Sticky Tab Bar -->
        <LinearLayout
            android:id="@+id/menuTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="?android:colorBackground"
            android:weightSum="3"
            app:layout_scrollFlags="noScroll">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tabGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Games"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"/>
                <View
                    android:id="@+id/underlineGames"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/instagram_orange"
                    android:visibility="visible"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tabVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Videos"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"/>
                <View
                    android:id="@+id/underlineVideos"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/instagram_orange"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tabDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"/>
                <View
                    android:id="@+id/underlineDetails"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/instagram_orange"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Tab divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Fragment container scrolls independently -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
