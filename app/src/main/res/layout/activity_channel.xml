<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Banner -->
        <ImageView
            android:id="@+id/bannerImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            />

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImage"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/profile"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/channelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DualWielded"

                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/subscriberCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="44.5K subscribers • 48 videos"

                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Menu (Games, Videos, Details) -->
        <!-- Menu (Games, Videos, Details) with underline -->
        <LinearLayout
            android:id="@+id/menuTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Games Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tabGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Games"
                  android:textStyle="bold"
                    android:padding="12dp" />

                <View
                    android:id="@+id/underlineGames"
                    android:background="#FF0000"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"

                    android:visibility="visible" />
            </LinearLayout>

            <!-- Videos Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tabVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Videos"
                    android:textStyle="bold"

                    android:padding="12dp" />

                <View
                    android:id="@+id/underlineVideos"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FF0000"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Details Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"

                android:gravity="center">

                <TextView
                    android:id="@+id/tabDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details"
                 android:textStyle="bold"
                    android:padding="12dp" />

                <View
                    android:id="@+id/underlineDetails"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FF0000"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Video List Placeholder -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
